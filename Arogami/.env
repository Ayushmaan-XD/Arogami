# Arogami Frontend Environment Variables
# Vite requires all environment variables to be prefixed with VITE_

# Backend API URL - Node.js/Express backend
VITE_API_URL=https://arogami-backend.onrender.com

# Machine Learning API URL - Python ML service
VITE_ML_API_URL=https://arogami.onrender.com

# Socket.IO URL - WebSocket connection (usually same as backend)
VITE_SOCKET_URL=https://arogami-backend.onrender.com

# Google OAuth Client ID - Required for Google login
VITE_GOOGLE_CLIENT_ID=384056501722-rjpmvsabipg8qhovo9nb2637sce1kp2a.apps.googleusercontent.com

# For local development, uncomment these lines instead:
# VITE_API_URL=http://localhost:5000
# VITE_ML_API_URL=http://localhost:5001
# VITE_SOCKET_URL=http://localhost:5000
